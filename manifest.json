{
  "manifest_version":3,
  "name":"TrainerDB Copilot",
  "version":"1.0",
  "description":"AI assistant for TrainerDB users",
  "permissions":[
    "storage",
    "activeTab",
    "scripting"
  ],
  "action":{
    "default_popup":"popup.html"
  },
  "content_scripts":[
    {
      "matches":["https://trainerdb.com/*"],
      "js":["content.js"]
    }
  ]
}